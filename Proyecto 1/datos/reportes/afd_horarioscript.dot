digraph AFD_HorarioScript {
    rankdir=LR;
    fontname="Arial";
    node [shape=circle, fontname="Arial", fontsize=10];
    INICIO [shape=doublecircle, style=filled, fillcolor="#dceefb"];
    ACEPTA_SIMBOLO [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_PALABRA_RESERVADA [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_CODIGO [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_COMENTARIO [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_ENTERO [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_CADENA [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ACEPTA_HORA [shape=doublecircle, style=filled, fillcolor="#e2f7e1"];
    ERROR_LEXICO [shape=box, style=filled, fillcolor="#fbdada"];
    INICIO -> LEYENDO_LETRA [label="letra"];
    LEYENDO_LETRA -> LEYENDO_LETRA [label="letra"];
    LEYENDO_LETRA -> LEYENDO_GUION [label="-"];
    LEYENDO_LETRA -> ACEPTA_PALABRA_RESERVADA [label="fin de palabra (reservada)"];
    LEYENDO_LETRA -> ERROR_LEXICO [label="fin de palabra (no reservada, sin guion)"];
    LEYENDO_GUION -> LEYENDO_DIGITOS_CODIGO [label="digito"];
    LEYENDO_GUION -> ERROR_LEXICO [label="no-digito (codigo mal formado)"];
    LEYENDO_DIGITOS_CODIGO -> LEYENDO_DIGITOS_CODIGO [label="digito"];
    LEYENDO_DIGITOS_CODIGO -> ACEPTA_CODIGO [label="separador"];
    LEYENDO_DIGITOS_CODIGO -> ERROR_LEXICO [label="no-separador (codigo mal formado)"];
    INICIO -> LEYENDO_DIGITO [label="digito"];
    LEYENDO_DIGITO -> LEYENDO_DIGITO [label="digito"];
    LEYENDO_DIGITO -> LEYENDO_DOS_PUNTOS [label=": (tras 2 digitos)"];
    LEYENDO_DIGITO -> ACEPTA_ENTERO [label="separador"];
    LEYENDO_DOS_PUNTOS -> LEYENDO_MINUTOS [label="digito"];
    LEYENDO_MINUTOS -> LEYENDO_MINUTOS [label="digito"];
    LEYENDO_MINUTOS -> ACEPTA_HORA [label="separador (2 digitos de minuto)"];
    LEYENDO_MINUTOS -> ERROR_LEXICO [label="separador (minutos != 2 digitos, o rango invalido)"];
    INICIO -> LEYENDO_CADENA [label="\""];
    LEYENDO_CADENA -> LEYENDO_CADENA [label="cualquier caracter != \n"];
    LEYENDO_CADENA -> ACEPTA_CADENA [label="\""];
    LEYENDO_CADENA -> ERROR_LEXICO [label="\n o EOF (cadena sin cerrar)"];
    INICIO -> LEYENDO_COMENTARIO [label="#"];
    LEYENDO_COMENTARIO -> ERROR_LEXICO [label="caracter != # (tras primer #)"];
    LEYENDO_COMENTARIO -> LEYENDO_COMENTARIO [label="cualquier caracter != \n (tras ##)"];
    LEYENDO_COMENTARIO -> ACEPTA_COMENTARIO [label="\n o EOF"];
    INICIO -> ACEPTA_SIMBOLO [label="{ } [ ] : ; ,"];
    INICIO -> ERROR_LEXICO [label="caracter no reconocido"];
}